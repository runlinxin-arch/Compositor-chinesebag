    "Animation export supports up to %@ frames, %lld megapixels across all exported frames, and 512 MiB of encoded data. Reduce the export size or frame count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Animation export supports up to %1$@ frames, %2$lld megapixels across all exported frames, and 512 MiB of encoded data. Reduce the export size or frame count."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画导出最多支持 %1$@ 帧，所有导出帧合计 %2$lld 百万像素，以及 512 MiB 编码数据。请减小导出尺寸或帧数。"
          }
        }
      }
    },
    "Another app changed this project. You can revert to the version on disk, losing your unsaved changes, or keep what you have.": {
