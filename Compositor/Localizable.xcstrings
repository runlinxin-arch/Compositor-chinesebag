        }
      }
    },
    "This Photoshop file uses a layer compression method that isn’t supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Photoshop 文件使用了不支持的图层压缩方式。"
          }
        }
      }
    },
    "This Photoshop layer type isn’t supported and was imported as pixels.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此 Photoshop 图层类型，已作为像素导入。"
          }
        }
      }
    },
    "This project exceeds the supported canvas, layer, file-size, or %lld-megapixel document limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目超出支持的画布、图层、文件大小或 %lld 百万像素的文档限制。"
          }
        }
      }
    },
    "This project uses format version %lld. This app supports versions %lld–%lld, 27, and %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This project uses format version %1$lld. This app supports versions %2$lld–%3$lld, 27, and %4$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目使用格式版本 %1$lld。此应用支持版本 %2$lld–%3$lld、27 和 %4$lld。"
          }
        }
      }
    },
