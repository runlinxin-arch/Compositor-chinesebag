    "This PDF is password-protected. Save an unlocked copy, then import that.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PDF 受密码保护。请保存一份未加密的副本后再导入。"
          }
        }
      }
    },
    "This Photoshop file uses a format version Compositor can’t read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Photoshop 文件使用了 Compositor 无法读取的格式版本。"
