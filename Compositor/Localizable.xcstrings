      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-点击设置源点 · 拖动仿制 · [ ] 大小 · Shift-[ ] 硬度 · 1–0 不透明度 · 空格平移"
