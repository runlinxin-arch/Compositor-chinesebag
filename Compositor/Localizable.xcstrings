      }
    },
    "Hue Shift": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相偏移"
          }
        }
      }
    },
    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相改变颜色，饱和度改变强度，明度改变亮度。"
          }
        }
      }
    },
