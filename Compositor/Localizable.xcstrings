    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use 1–%1$@ pixels per side, up to %2$lld megapixels, and 1–9,600 pixels/inch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边使用 1–%1$@ 像素，最多 %2$lld 百万像素，以及每英寸 1–9,600 像素。"
          }
        }
      }
    },
    "Use a CMYK ICC profile, such as the one your printer gave you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 CMYK ICC 配置文件，例如打印机提供的配置文件"
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use gridlines every %1$lld–%2$@ pixels and %3$lld–%4$lld subdivisions, no more than the pixels between gridlines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔 %1$lld–%2$@ 像素使用网格线，%3$lld–%4$lld 个细分，且不超过网格线之间的像素数。"
          }
        }
      }
    },
    "Use smooth squircle corners at 60% smoothing, matching Figma's iOS setting": {
